# Divine Client server configuration.
# Copy this file to  .env  and fill in the real values, then upload the .env
# file to your server. Keep .env private - it holds your secrets.
#
# With the domain pointed at this box (what divineclient.wispbyte.org does), leave
# the two *_URL lines as they are. On a bare ip:port with no certificate yet,
# replace them with http://YOUR_IP:YOUR_PORT (and use that same origin in the
# Discord Developer Portal's OAuth2 redirect list, byte for byte).

DISCORD_CLIENT_ID=1544313910096560128
DISCORD_CLIENT_SECRET=paste_your_oauth_client_secret_here
DISCORD_BOT_TOKEN=paste_your_bot_token_here
SECRET_KEY=paste_a_long_random_string_here

# Lets you post announcements over the API (and with post_news.py).
# Pick any long random string. Leave blank to disable the admin endpoints.
ADMIN_KEY=paste_another_long_random_string_here

# The canonical origin of this site. Everything the app builds - OAuth redirect,
# sitemap, robots, the URLs inside launcher responses - comes from here.
PUBLIC_BASE_URL=https://divineclient.wispbyte.org
OAUTH_REDIRECT_URI=https://divineclient.wispbyte.org/discord/callback

# The launcher build you publish. Every copy of Divine Client asks /api/client/version
# on startup, compares this with the version it was built as, and - when they differ -
# downloads DOWNLOAD_URL, checks the sha256 and swaps itself on the next restart. So
# bump clientversion at the same moment you upload the new archive, not after.
# Leave clienturl blank to keep the launcher's news pill on "download from the site".
clientversion=1.0
clienturl=
clientsha256=
clientsize=
clientnotes=

# Old links people already have. Requests for any of these hosts are 301'd to
# PUBLIC_BASE_URL (pages only - /api/, /static/ and /assets/ are never redirected,
# and localhost or a private address is left alone).
#   legacy = only these hosts   all = any host that is not canonical   0 = off
CANONICAL_REDIRECT=legacy
LEGACY_HOSTS=devwummsy.site.je,78.154.103.46

# Links and text the website shows. All optional.
# The invite below is the real one (Divine development), checked against Discord's API.
# Every Discord button on the site, and the /discord redirect, come from this value -
# so if you ever re-issue the invite, change it here and nothing else has to move.
DISCORD_INVITE_URL=https://discord.gg/ER2haQtach
# Set DOWNLOAD_URL to a direct file and /download redirects there instead of
# rendering the install page (useful while the file lives on a panel or Drive).
DOWNLOAD_URL=
DOWNLOAD_NOTE=64-bit Windows 10 or 11

DIVINE_DB=data/divine.db
PORT=10230
